# Production Environment Variables
NODE_ENV=production
PORT=5000

# Database Configuration (Replace with your production MongoDB URI)
MONGODB_URI=mongodb+srv://psn_admin:<db_password>@psn-college-cluster.6ntxbjy.mongodb.net/?appName=psn-college-cluster

# JWT Configuration (Use strong secrets in production)
JWT_SECRET=your_super_secure_jwt_secret_key_for_production_minimum_32_characters
JWT_EXPIRE=7d

# Admin Configuration
ADMIN_EMAIL=admin@psn.edu.in
ADMIN_PASSWORD=SecureAdminPassword123!

# College Information
COLLEGE_NAME=PSN Engineering College
COLLEGE_CODE=PSN

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security Configuration
BCRYPT_ROUNDS=12